# ============== 环境变量配置文件 ==============
# 此文件用于本地开发，生产环境使用 GitHub Secrets
# ⚠️ 此文件已添加到 .gitignore，不会提交到仓库

# 数据库配置（生产环境使用 Docker Hub 的镜像，通过环境变量注入配置）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis 配置
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=7

# 安全密钥
# SECURITY_CODE=your-security-code

# ============== LLM 聊天模型 ==============
# ⚠️ 聊天大模型走 BYOK：DeepSeek / MiniMax 的 key 由每个用户在界面上
#    自行上传（加密后存库），服务器不持有、不需要配置。
#    这里只指定"用户没选时"的默认服务商: deepseek | minimax
LLM_PROVIDER=deepseek

# ============== Embedding 向量模型 ==============
# DeepSeek 不提供 embedding 接口，向量模型走硅基流动（免费、中文友好）
# https://cloud.siliconflow.cn
# 这一把 key 由服务器统一持有、所有用户共用
SILICONFLOW_API_KEY=your-siliconflow-api-key

# ============== 服务端密钥（必须配置）==============
# JWT 签名密钥，用于签发登录态
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 加密用户上传的 LLM API key（Fernet，32 字节 urlsafe-base64）
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 此值一旦确定不可更改：已加密的用户 key 只有用同一把密钥才能解开
KB_ENCRYPTION_KEY=

# 登录态有效期（分钟），默认 1440 = 24 小时
JWT_EXPIRE_MINUTES=1440

# ============== 向量库持久化 ==============
# Docker 部署时需挂载 volume，否则容器重建会丢
CHROMA_PERSIST_DIR=./data/chroma
MEM0_PERSIST_DIR=./data/chroma_mem0